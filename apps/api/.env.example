# AVGOON API local/deployment environment template
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5500

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/avgoon?schema=public

# Authentication secrets: replace with independently generated random values (32+ chars)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token-at-least-32-characters

# Email OTP via Resend HTTPS API (free tier available; verify your sender domain first)
RESEND_API_KEY=
RESEND_FROM=

# SMS OTP is not enabled until a provider-specific adapter is implemented.
