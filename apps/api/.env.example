# AVGOON API local/deployment environment template
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5500

# PostgreSQL (Neon Free plan: use the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/avgoon?sslmode=require

# Authentication secrets: replace with independent random values (32+ chars)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token-at-least-32-characters

# Email OTP via Brevo HTTPS API (free tier: 300 emails/day)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# SMS OTP is disabled until a provider-specific adapter is implemented.
